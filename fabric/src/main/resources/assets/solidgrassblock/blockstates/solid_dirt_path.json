{
  "multipart": [
    {
      "apply": {
        "model": "solidgrassblock:block/solid_dirt_path"
      },
      "when": {
        "full_cube": false,
        "connected": false
      }
    },
    {
      "apply": {
        "model": "solidgrassblock:block/solid_dirt_path_full_cube"
      },
      "when": {
        "full_cube": true,
        "connected": false
      }
    },
    {
      "apply": {
        "model": "solidgrassblock:block/solid_dirt_path_full_cube"
      },
      "when": {
        "full_cube": false,
        "connected": true
      }
    },
    {
      "apply": {
        "model": "solidgrassblock:block/solid_dirt_path_full_cube"
      },
      "when": {
        "full_cube": true,
        "connected": true
      }
    }
  ]
}
