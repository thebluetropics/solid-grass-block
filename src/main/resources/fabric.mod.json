			"config": "%mod_id%.common.mixins.json"
		}
	],
	"depends": {
		"minecraft": "%minecraft_version%",
		"fabricloader": ">=0.16.0",
		"fabric-api": ">=0.97.8+1.20.6",
		"java": ">=21"
