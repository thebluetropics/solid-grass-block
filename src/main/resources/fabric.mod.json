{
	"schemaVersion": 1,
	"id": "%mod_id%",
	"version": "%version%",
	"name": "%mod_name%",
	"description": "A decorative mod that introduces you Solid Grass Block(s)",
	"authors": [
		{
			"name": "thebluetropics",
			"contact": {
				"email": "thebluetropics@gmail.com",
				"homepage": "https://github.com/thebluetropics"
			}
		}
	],
	"license": "MIT",
	"contact": {
		"sources": "https://github.com/thebluetropics/solid-grass-block",
		"issues": "https://github.com/thebluetropics/solid-grass-block/issues"
	},
	"icon": "assets/%mod_id%/icon.png",
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.com/invite/A9hgghDk48"
			},
			"update_checker": false
		}
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.thebluetropics.solidgrassblock.SolidGrassBlockMod"
